{
  "name": "backend",
  "version": "1.0.0",
  "description": "backend node 16",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon server.js",
    "test:watch": "jest --watch",
    "test": "jest --coverage",
    "test:verbose": "jest --coverage --verbose"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/addieljuarez/fullstack-Addiel-Juarez.git"
  },
  "author": "Addiel Juarez",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/addieljuarez/fullstack-Addiel-Juarez/issues"
  },
  "homepage": "https://github.com/addieljuarez/fullstack-Addiel-Juarez#readme",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "standard": "^17.1.2",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/config/database.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "engines": {
    "npm": ">=8.0.0 <9.0.0",
    "node": ">=16.0.0 <17.0.0"
  }
}
